      <rules>
        <rule id="0d78cfe9-2160-49a8-09e9-6e415b92eba4" name="Attachment (Hex Hunters)" publicationId="20446671--pubN65952" page="77" hidden="false">
          <description>This attachment can be added to Hex Hunters unit.</description>
        </rule>
        <rule id="b198e2ea-49bf-fc78-f16a-6bbdb2bfc62e" name="Granted: Hunter" publicationId="20446671--pubN65952" page="77" hidden="false">
          <description>While this model is in play, models in this unit gain Hunter. (A model with Hunter ignores forests, concealment, and cover when determining LOS or making a ranged attack.)</description>
        </rule>
        <rule id="be34dd71-ae0e-052c-56ae-fefd61ec6112" name="Magic Ability (7)" publicationId="20446671--pubN65952" page="77" hidden="false">
          <description>• Frostbite (*Attack) - Frostbite is a RNG SP 8 magic attack. Models hit suffer a POW 12 cold damage roll.

• Hex Bolt (*Attack) - Hex Bolt is RNG 6, POW 13 magic attack. Models hit cannot make special actions or special attacks for one round.</description>
        </rule>
        <rule id="814c6706-68d3-4583-fac7-25d27fe348fd" name="Tactics: Advance Deployment" publicationId="20446671--pubN65952" page="77" hidden="false">
          <description>Models in this unit gain Advance Deployment.</description>
        </rule>
        <rule id="f5335d8d-00a7-5b50-b994-725c3edbce09" name="He Razor: Magical Weapon" publicationId="20446671--pubN65952" page="77" hidden="false"/>
        <rule id="9133f79e-abc4-2804-9831-5c0c7bd47a87" name="Hex Razor: Weapon Master" publicationId="20446671--pubN65952" page="77" hidden="false"/>
        <rule id="1927d705-4cdc-6b9e-ff0b-9627acbaf058" name="Hex Razor: Shadow Bind" publicationId="20446671--pubN65952" page="77" hidden="false">
          <description>A model hit by this weapon suffers -3 DEF and when it advances it cannot move except to cane facing. Shadow Bind expires after one round.</description>
        </rule>
      </rules>
