        <rule id="d7456706-7daa-375a-731a-bbd7ea017a15" name="Dragon Breath: Critical Fire" publicationId="20446671--pubN66206" page="114" hidden="false"/>
        <rule id="5702eab6-40d3-4872-04d2-dab356e95366" name="Dragon Breath: Damage Type - Fire" publicationId="20446671--pubN66206" page="114" hidden="false"/>
        <rule id="03dbe910-d375-e99d-5fa6-c63a83691de6" name="Dragon Breath: Strafe [d3+1] (*Attack)" publicationId="20446671--pubN66206" page="114" hidden="false">
          <description>Make d3+1 ranged attacks targeting a primary target and any number of secondary targets within 2&quot; of the first target. Ignore intervening models when declaring secondary targets. A secondary target cannot be targeted by more attacks than the primary target. Strife counts as one attack for ROF.</description>
        </rule>
        <rule id="5d9a9d70-b1be-2220-1efb-bdaeefebae71" name="Bite: Consume" publicationId="20446671--pubN66206" page="114" hidden="false">
          <description>If the attack hit a small-based non-warlock/warcaster model the model hit is removed from play.</description>
        </rule>
        <rule id="903b98a2-2514-d1c1-c5e6-9d331827de00" name="Claws: Open Fist" publicationId="20446671--pubN66206" page="114" hidden="false"/>
