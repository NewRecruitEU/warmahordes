      <rules>
        <rule id="cf84666e-4734-83ea-529d-89674c74ac91" name="Attachment (Blighted Nyss Striders)" publicationId="20446671--pubN65952" page="81" hidden="false">
          <description>This attachment can added to a Blighted Nyss Striders unit.</description>
        </rule>
        <rule id="d7c4e2a5-4570-2b8d-7749-04a1115d126e" name="Officer: Advanced Deployment" publicationId="20446671--pubN65952" page="81" hidden="false"/>
        <rule id="aab03e60-7270-33bd-60db-c7867a5bc96d" name="Officer: Combined Ranged Attack" publicationId="20446671--pubN65952" page="81" hidden="false"/>
        <rule id="e158cf59-b7eb-f2b0-0be4-5432a831a687" name="Officer: Officer" publicationId="20446671--pubN65952" page="81" hidden="false"/>
        <rule id="23e3e1e4-f24a-1ad7-257d-52415fcaaa1b" name="Officer: Stealth" publicationId="20446671--pubN65952" page="81" hidden="false"/>
        <rule id="dcabe1d4-3003-d2ee-f6f1-3a7348ed025a" name="Officer: Pathfinder" publicationId="20446671--pubN65952" page="81" hidden="false"/>
        <rule id="86d95be4-e929-7bfb-297e-e23bb7a89aa5" name="Officer: Granted - Reform" publicationId="20446671--pubN65952" page="81" hidden="false">
          <description>While tis model is in play, after all models in its unit have completed their actions, each can advance up to 3&quot;.</description>
        </rule>
        <rule id="3a4493a9-8a7e-6623-900a-80f7ec033220" name="Officer: Tactics - Hunter" publicationId="20446671--pubN65952" page="81" hidden="false">
          <description>Models in this unit gain Hunter. (A model with Hunter ignores forests, concealment, and cover when determinging LOS or making a ranged attack.)</description>
        </rule>
        <rule id="2a581235-a012-36f7-29c3-6fc43b3b542d" name="Musician: Advanced Deployment" publicationId="20446671--pubN65952" page="81" hidden="false"/>
        <rule id="f41fff42-8385-f257-3e24-8555dc3b11a4" name="Musician: Combined Ranged Attack" publicationId="20446671--pubN65952" page="81" hidden="false"/>
        <rule id="52a48a3f-5fbd-c413-7af5-962f99662563" name="Musician: Pathfinder" publicationId="20446671--pubN65952" page="81" hidden="false"/>
        <rule id="9682f6b3-980b-c937-08bd-ea748b9c0288" name="Musician: Stealth" publicationId="20446671--pubN65952" page="81" hidden="false"/>
        <rule id="eeabdad5-8dcd-5325-3b28-3d017809415f" name="Musician: In Step" publicationId="20446671--pubN65952" page="81" hidden="false">
          <description>While this model is within 3&quot; of it, the unit commander gain +3&quot; to its command range.</description>
        </rule>
        <rule id="efaa081f-7b3c-9c75-b381-e8c2541910c2" name="Musician: Take Up" publicationId="20446671--pubN65952" page="81" hidden="false">
          <description>If this model is destoryed or removed from play, you can choose a Grunt in this unit within 1&quot; of this model to take its place. Effects on this model exprire, and it gains the effects on the chosen Grunt. Remove the Grunt form the table instead of this model. This model has the same number of unmarked damage boxes as th chosen Grunt.</description>
        </rule>
      </rules>
      <categoryLinks>
        <categoryLink id="6eb9d44a-a83a-e8b0-65ee-c28678cfa979-556e697423232344415441232323" hidden="false" targetId="556e697423232344415441232323" primary="true" name="Unit"/>
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="points" value="3"/>
      </costs>
    </selectionEntry>
