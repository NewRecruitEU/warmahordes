      <rules>
        <rule id="8cfc271f-5128-b705-5942-87cf1878294d" name="Feat: Foreboding" publicationId="20446671--pubN65952" page="44" hidden="false">
          <description>While within her control area, small-, medium-, and large-based models in Saeryn&apos;s battlegroup cannot be targeted by melee attacks for one round.</description>
        </rule>
        <rule id="0c89602e-7783-a496-7840-8a7da2c369ed" name="Thrown Deathspur: Magical Weapon" publicationId="20446671--pubN65952" page="44" hidden="false"/>
        <rule id="900985b8-1206-35f9-1cf3-94ca0aa7bf59" name="Thrown Deathspur: Grievous Wounds" publicationId="20446671--pubN65952" page="44" hidden="false">
          <description>When a model is hit by this weapon, for one round it loses Tough, cannot hal or be healed, and cannot transfer damage.</description>
        </rule>
        <rule id="49fafab0-8911-b0ce-6053-e61338c21f96" name="Thrown Deathspur: Thrown" publicationId="20446671--pubN65952" page="44" hidden="false">
          <description>Add this model&apos;s STR to the POW of this ranged attack.</description>
        </rule>
        <rule id="2e2e215b-7fdd-31e4-1224-388bd45c80e7" name="Deathspur: Magical Weapon" publicationId="20446671--pubN65952" page="44" hidden="false"/>
        <rule id="cc3921d6-189e-608d-a2bf-3681dc0179ba" name="Deathspur: Grievous Wounds" publicationId="20446671--pubN65952" page="44" hidden="false">
          <description>When a model is hit by this weapon, for one round it loses Tough, cannot hal or be healed, and cannot transfer damage.</description>
        </rule>
      </rules>
