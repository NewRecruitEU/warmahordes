  <selectionEntries>
    <selectionEntry id="721b-0e53-0d32-7be2" name="Absylonia, Daughter of Everblight" publicationId="20446671--pubN65554" hidden="false" collective="false" import="true" type="model">
      <constraints>
        <constraint field="selections" scope="force" value="1" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="maxInForce" type="max"/>
        <constraint field="selections" scope="roster" value="1" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="maxInRoster" type="max"/>
      </constraints>
      <rules>
        <rule id="aec8-7d8a-1277-692f" name="Legion Epic Blighted Nyss Warlock" hidden="false"/>
        <rule id="bafd-f79e-546a-e685" name="Feat: Metamorphose" hidden="false">
          <description>Models in Absylonia&apos;s battlegroup that are currently in her control area gain +2 STR and Flight, and their melee weapons gain Reach. Metamorphose lasts for one round.</description>
        </rule>
        <rule id="5d0a-a688-e9aa-1269" name="Conferrred Rage" hidden="false">
          <description>Warbeasts in this model&apos;s battlegroup beginning their activations in its control area can charge or make power attacks without being forced. When this model destroys one or more enemy models during its activation, warbeasts in its battlegroup beginning their activation in its control area gain +2 SPD and MAT for one turn.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="040e-7ad2-279e-cf83" hidden="false" targetId="dd7c752a-3375-96c7-70a4-e80202b66249" type="rule" name="Abomination"/>
