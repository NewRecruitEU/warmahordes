      <rules>
        <rule id="864bcf67-b05b-acb6-4766-84432303d326" name="Beast Manipulation" publicationId="20446671--pubN65952" page="89" hidden="false">
          <description>A warbeast can be affected by only one Beast Manipulation special action each turn.

• Condition (*Action) - RNG 3. Target friendly Faction warbeast. If the warbeast is in range, place any number of fury points on or remove any number of fury points from it.

• Medicte (*Action) - RNG 3. Target friendly Faction warbeast. If the warbeast is in range, it heals d3 damage points. A warbeast can be affected by Medicate only once per turn.</description>
        </rule>
        <rule id="226cbe8e-7bc2-1e88-268a-6825c0866b7e" name="Crooked Staff: Reach" publicationId="20446671--pubN65952" page="89" hidden="false"/>
      </rules>
      <infoLinks>
        <infoLink id="504c8c3d-3d6b-8e97-967c-7fefc08f03be" hidden="false" targetId="fea3ad00-398b-883e-2164-2e1286de9638" type="rule" name="Beast Master"/>
