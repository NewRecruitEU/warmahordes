      </profiles>
      <rules>
        <rule id="c389ce5f-0bd4-bb2e-dcb0-e0887f102291" name="Feat: Host of Angels" publicationId="20446671--pubN73748" page="70" hidden="false">
          <description>When a friendly living non-Incubus warrior model in Kallus&apos; control are is disabled by an enemy attack, you can replace it with an Incubus model. The replaced model is removed from play. While in Kallus&apos; control area friendly soulless warrior model gain +2 DEF. Host of Angels last for one round.</description>
        </rule>
        <rule id="8172e626-83f5-27de-7fb2-c11bdd3166a4" name="Hellbrand: Magical Weapon" publicationId="20446671--pubN73748" page="70" hidden="false"/>
        <rule id="89bcecf5-0af1-86d9-e226-067ff2c61eed" name="Hellbrand: Reach" publicationId="20446671--pubN73748" page="70" hidden="false"/>
        <rule id="cdf9cfd0-d32a-7411-638b-fc8157c10dcb" name="Hellbrand: Flame Burst" publicationId="20446671--pubN73748" page="70" hidden="false">
          <description>When this model boxes an enemy model with this weapon, enemy models within 1&quot; of the boxed model suffer the Fire continuous effect.</description>
        </rule>
      </rules>
