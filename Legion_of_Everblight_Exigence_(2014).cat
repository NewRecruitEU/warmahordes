      <rules>
        <rule id="072ae8bf-8ca1-9ec4-a10c-f97554e86220" name="Magic Ability (7)" publicationId="20446671--pubN73748" page="80" hidden="false">
          <description>• Frostbite (*Attack) - Frostbite is a RNG SP 8 magic attack. Models hit suffer a POW 12 cold damage roll.

•Spine Burst (*Attack) - Spine Burst is a RNG 10, POW 10 magic attack. If target model is hit, the d3 nearst models within 5&quot; of it suffer a POW 10 magical damage roll.</description>
        </rule>
        <rule id="df3704d7-1d8d-86d1-e5bb-665461cac3ed" name="Tentacle: Reach" publicationId="20446671--pubN82944" page="80" hidden="false"/>
        <rule id="7a2c34fd-d638-1d01-c31e-d5e02f50d9d1" name="Tentacle: Chain Strike" publicationId="20446671--pubN73748" page="80" hidden="false">
          <description>This weapon has a 4&quot; melee range during this model&apos;s activation.</description>
        </rule>
        <rule id="9bfd63ba-0c8a-89af-5687-ae5637099614" name="Tentacle: Chain Weapon" publicationId="20446671--pubN73748" page="80" hidden="false">
          <description>This attack ignores the Buckler and Shield weapon qualities and Shield Wall.</description>
        </rule>
      </rules>
