      <rules>
        <rule id="6cc2-57b9-88a4-20f2" name="Legion Warbeat Pack" hidden="false"/>
        <rule id="8de2-50c1-1890-8a37" name="Annoyance" hidden="false">
          <description>Living models within 1&quot; of this model suffer -1 to attack rolls.</description>
        </rule>
        <rule id="fe97-8de2-0a7d-51c2" name="Hunting Pack" hidden="false">
          <description>This model gains a +1 cumulative bonus to melee attack and damage rolls for each other model in this unit engaging the model it is attacking.</description>
        </rule>
