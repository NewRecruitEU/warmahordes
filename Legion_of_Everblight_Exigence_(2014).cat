      <rules>
        <rule id="5b780511-859c-d8b2-83f6-e1ffae7d3212" name="Feat: Litany of Everblight" publicationId="20446671--pubN65952" page="34" hidden="false">
          <description>While in this model&apos;s control area, friendly Faction models gain boosted magic attack rolls and magic attack damage rolls, and friendly Faction warbeasts can use their animi without being forced. Litany of Everblight lasts for one turn.</description>
        </rule>
        <rule id="b285e01f-dcc6-a61d-bd91-04e838a2f79c" name="Flesh Meld" publicationId="20446671--pubN65952" page="34" hidden="false">
          <description>refer to page 34 its a long rule.</description>
        </rule>
        <rule id="a806e8a8-4082-a7dc-3942-d140d5ed1bfe" name="Talons of Everblight: Continuous Effect - Corrosion" publicationId="20446671--pubN65952" page="34" hidden="false"/>
        <rule id="aec5bef1-d56e-9daa-26ec-413cf84db630" name="Talons of Everblight: Magical Weapon" publicationId="20446671--pubN65952" page="34" hidden="false"/>
        <rule id="50c562f8-e36f-7f6c-d8e5-ddc1f096a0a4" name="Companion ( Bethayne, Voice of Everblight)" publicationId="20446671--pubN65952" page="37" hidden="false">
          <description>This model is included in any army that includes bethayne, Voice of Everblight. If Bethayne is destoryed or removed from play, remove this model from play. This model is part of Bethayne&apos;s battlegroup.</description>
        </rule>
        <rule id="12abb26e-1fe8-61ff-4c34-a57961bacfad" name="Belphagor: Claw - Open Fist" publicationId="20446671--pubN65952" page="37" hidden="false"/>
