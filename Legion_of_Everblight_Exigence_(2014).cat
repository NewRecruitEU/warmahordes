      <rules>
        <rule id="5e245fa6-16bd-deb3-a838-8b6c53c6eddf" name="Attachment (Blighted Nyss Swordsmen)" publicationId="20446671--pubN65952" page="83" hidden="false">
          <description>This attachment can be added to a Blighed Nyss Swordsmen unit.</description>
        </rule>
        <rule id="85682e6a-9bd5-5d41-1238-eaa351c6074a" name="Abbot: Fearless" publicationId="20446671--pubN65952" page="83" hidden="false"/>
        <rule id="c510a846-3691-bb70-4f08-8a5adad23cf8" name="Abbot: Oficer" publicationId="20446671--pubN65952" page="83" hidden="false"/>
        <rule id="92f39fb6-2d53-a060-3c92-ab0072b707e1" name="Abbot: Granted - Cleave" publicationId="20446671--pubN65952" page="83" hidden="false">
          <description>While this model is in play, models in its unit gain Cleave. (When a model with Cleave destorys one or more enemy models with a melee attack during its activation, immediately after the attack is resovled th model can maek one additional melee attack. A model can gain only one additional attack from Cleave per activation.)</description>
        </rule>
        <rule id="639cd1a7-3d5e-0893-c39d-632b0c1ef474" name="Abbot: Tactics - Overtake" publicationId="20446671--pubN65952" page="83" hidden="false">
          <description>Models in thsi unit gain Overtake. (When a model with Overtake destroy one or more enmey warrior models with a normal melee attack, after the attack&apos;s is resolved thsi model can immediately advance up to 1&quot;.)</description>
        </rule>
        <rule id="17587f73-f224-2ec4-e7f1-b6464652de00" name="Nyss Claymore: Weapon Master" publicationId="20446671--pubN65952" page="83" hidden="false"/>
        <rule id="5665b5cc-7eee-1155-7db7-f32d91d446c0" name="Champion: fearless" publicationId="20446671--pubN65952" page="83" hidden="false"/>
        <rule id="807854f4-55c6-e493-bf7a-b3a50e1a5437" name="Champion: Defensive Strike" publicationId="20446671--pubN65952" page="83" hidden="false">
          <description>Once per turn, when an enemy model advances into and ends its movemment in this model&apos;s melee range, tsi model can immediately make one normal attack against it.</description>
        </rule>
        <rule id="a94a072e-6217-cfe1-f55c-b73984a808a8" name="Nyss Claymore (Champion Only): Weapon Master" publicationId="20446671--pubN65952" page="83" hidden="false"/>
        <rule id="8c22d395-2b64-a8ba-8906-afe3b72d7b04" name="Nyss Claymore (Champion Only): Combo strike (*Attack)" publicationId="20446671--pubN65952" hidden="false">
          <description>Make a melee attack. Instead of making a normal damage roll, the POW of the damage roll is equal to this model&apos;s STR plus twice the POW of this weapon.</description>
        </rule>
      </rules>
      <categoryLinks>
        <categoryLink id="08c8bc6a-445b-b91f-de13-144379dccd64-556e697423232344415441232323" hidden="false" targetId="556e697423232344415441232323" primary="true" name="Unit"/>
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="points" value="3"/>
      </costs>
    </selectionEntry>
    <selectionEntry id="05af13eb-32f7-4ec2-907d-399e3a375ba2" name="Blighted Ogrun Warmongers" publicationId="20446671--pubN65952" page="84" hidden="false" collective="false" import="true" type="unit">
