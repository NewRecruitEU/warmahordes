            <characteristic name="MAT" typeId="4d415423232344415441232323">7</characteristic>
            <characteristic name="RAT" typeId="5.2415423232344416e+25">4</characteristic>
            <characteristic name="DEF" typeId="4.445462323234441e+25">13</characteristic>
