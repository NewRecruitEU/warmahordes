    <selectionEntry id="c9785531-2224-4134-acfb-211a45c12775" name="Wraith Engine" publicationId="f77f35f4--pubN77883" page="96" hidden="false" collective="false" import="true" type="model">
      <constraints>
        <constraint field="selections" scope="force" value="2" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="maxInForce" type="max"/>
      </constraints>
      <rules>
        <rule id="f39e778f-5993-72c1-8ec2-c5c797c08b5e" name="Apparation" page="0" hidden="false">
          <description>During your Control Phase, place this model anywhere completely within 2&quot; of its current location.</description>
        </rule>
        <rule id="384e79cd-f702-e90f-e764-dcb620a13a5d" name="Ectoplasm" page="0" hidden="false">
          <description>During this model&apos;s activation, it can spend one or more soul tokens to place 3&quot; AOE cloud effects on teh table anywhere completely within its command range, one AOE per soul token spent. The cloud effect remains in play for one round.</description>
        </rule>
        <rule id="c7d6e43e-c265-381e-6529-9fb8d9b75a5a" name="Unhallowed" page="0" hidden="false">
          <description>While another friendly Faction model is Incorporeal and in this model&apos;s command range, the other friendly Faction model gains +2 ARM and does not suffer blast damage.</description>
        </rule>
        <rule id="bb7ad514-b564-dbe3-e7df-6983eaa0e744" name="Wraith Walker" page="0" hidden="false">
          <description>At the end of your Control Phase, this model can gain Incorporeal for one round unless it gained Incorporeal during the last round.</description>
        </rule>
        <rule id="0f45-3400-d808-15e1" name="Cryx Battle Engine" hidden="false"/>
      </rules>
      <infoLinks>
        <infoLink id="cbbb-37d7-32b9-bbca" hidden="false" targetId="ea89-9b47-4f27-7185" type="rule" name="Dark Shroud"/>
