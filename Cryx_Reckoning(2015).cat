            <rule id="75b7418e-4202-a0f3-7ee1-a64922b1fb94" name="Companion [Goreshade the Bastard]" page="0" hidden="false">
              <description>This model is included in any army that includes Goreshade the Bastard. If Goreshade is destroyed or removed from play, remove this model from play. This model is part of Goreshade&apos;s battlegroup.</description>
            </rule>
            <rule id="cb1ccda2-526b-5d17-423d-13a1bfa73bd6" name="Dark Restoration [Goreshade the Bastard]" page="0" hidden="false">
              <description>If Goreshade the Bastard is disabled while within 3&quot; of this model, this model is destroyed and Goreshade heals 1 damage print.</description>
            </rule>
            <rule id="a69056a0-eea7-9d96-c776-6ca0c35890cc" name="Tether [Goreshade the Bastard]" page="0" hidden="false">
