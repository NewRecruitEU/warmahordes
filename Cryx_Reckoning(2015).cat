    <selectionEntry id="05fcf360-929f-4c10-8ac8-6f81fc0c89be" name="Deathjack" publicationId="f77f35f4--pubN66647" page="82" hidden="false" collective="false" import="true" type="model">
      <constraints>
        <constraint field="selections" scope="force" value="1" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="maxInForce" type="max"/>
        <constraint field="selections" scope="roster" value="1" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="maxInRoster" type="max"/>
      </constraints>
      <rules>
        <rule id="503b6b7a-33ed-64a5-0d43-22aa2aed5264" name="Necromancy" page="0" hidden="false">
          <description>While this model is in its controller&apos;s control area, it can spend focus points to cast its controller&apos;s spells. When this model casts its controller&apos;s spells, the controller is considered to have cast them but this model is their point of origin. When making a magic attack roll, this model uses its controller&apos;s FOCUS. This model cannot cast spells with a RNG of SELF or CTRL.</description>
        </rule>
        <rule id="7da1ac75-956f-dfaa-2e8a-ca94f566f5cd" name="Rendering" page="0" hidden="false">
          <description>When this model gains a soul token, it can immediately spend that token to remove d6 damage points.</description>
        </rule>
        <rule id="fd503e75-c749-a3e6-9d86-e24d6a82404b" name="Skulls of Hate" page="0" hidden="false">
          <description>During your Control Phase, after focus allocation this model gains 1 focus point for each of its arm systems that is currently not crippled. While this model has one or more non-crippled arm systems, its front arc extends to 360°.</description>
        </rule>
        <rule id="0b43-a2ac-49e2-ec6b" name="Cryx Character Helljack" hidden="false"/>
      </rules>
      <infoLinks>
        <infoLink id="9ff2-3076-1789-767c" hidden="false" targetId="ef15e40b-6b87-20c8-8e6e-ecc3a787c5e4" type="rule" name="Abomination"/>
        <infoLink id="e425-e123-035f-f853" hidden="false" targetId="1f8d5503-7901-355c-93cd-ce8ef5cf66f3" type="rule" name="Advance Deployment"/>
        <infoLink id="f0e1-6416-17b0-39a3" hidden="false" targetId="bc4c-dedb-0275-bd9a" type="rule" name="Cull Soul"/>
