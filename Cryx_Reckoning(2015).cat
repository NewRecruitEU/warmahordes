            <rule id="148ea524-f72b-8116-f763-399107fcc084" name="Thrall Bomb" page="0" hidden="false">
              <description>When this model is disabled, center a 4&quot; AOE on it and then remove this model from play. Models in the AOE are hit and suffer a POW 8 blast damage roll.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="7e8c-7b16-c645-7f83" hidden="false" targetId="21b0922f-4ce2-396f-8960-5747cf7bddca" type="rule" name="Undead"/>
