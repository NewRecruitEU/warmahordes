              <characteristics>
                <characteristic name="SPD" typeId="5.3504423232344415e+25">6</characteristic>
                <characteristic name="STR" typeId="5.354522323234442e+25">7</characteristic>
                <characteristic name="MAT" typeId="4d415423232344415441232323">7</characteristic>
                <characteristic name="RAT" typeId="5.2415423232344416e+25">4</characteristic>
