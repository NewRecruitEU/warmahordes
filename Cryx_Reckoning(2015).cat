        <constraint field="selections" scope="roster" value="1" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="maxInRoster" type="max"/>
      </constraints>
      <rules>
        <rule id="752b65b7-5d17-238d-dcda-99d9e631d260" name="Possession" page="0" hidden="false">
          <description>When this model hits an enemy warjack that has a functional cortex with a melee attack, it can spend a soul token to take control of the warjack. Immediately after teh attack has been resolved, you can make a full advance the warjack and can then make one normal attack, then Possession expires.</description>
        </rule>
        <rule id="4f6b7d96-5bdc-8428-f689-a5824e960fa1" name="Well of Souls" page="0" hidden="false">
          <description>This model begins the game with one soul token.</description>
        </rule>
        <rule id="c171-9a33-c3b6-4615" name="Cryx Character Helljack" hidden="false"/>
      </rules>
