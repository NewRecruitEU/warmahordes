        <rule id="fbd3-c831-40e0-3b16" name="Feat: Assassination Run" hidden="false">
          <description>While in Morghoul&apos;s control area, friendly Faction models gain +2 DEF and Evasive. Assassination Run lasts for one round. (A model with Evasive cannot be targeted by free strikes. It can advance up to 2&quot; immediately after an enemy ranged attack that missed it is resolved unless it was missed while advancing.)</description>
        </rule>
        <rule id="b635-5dea-90fb-6d05" name="Elite Cadre [Paingivers]" hidden="false">
          <description>Friendly Paingiver models gain Perfect Balance.</description>
        </rule>
