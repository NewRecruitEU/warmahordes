      <rules>
        <rule id="1d9ea4df-f4b6-67dc-9a9c-2fc61eca8581" name="Feat: Death Harvest" publicationId="d740d6ea--pubN68778" page="54" hidden="false">
          <description>Each time a Friendly model destroys an enemy model while the friendly model is in Calaban&apos;s contorl area, Calaban gains 1 fury point. Immediately after resolving an attack in which a model in Calaban&apos;s control area destroys one or more enemy models, Calaban can boost attack and damage rolls on spells cast as a result of Death Harvest. Death Harvest lasts for one turn.</description>
        </rule>
        <rule id="7b00-ab04-a709-7508" name="Minion Gatorman Warlock" hidden="false"/>
      </rules>
      <infoLinks>
        <infoLink id="bb153425-791d-b2d9-4f47-1a089f820d59" hidden="false" targetId="07eda051-a145-4f77-23c3-1dbfa4d8e24b" type="rule" name="Amphibious"/>
