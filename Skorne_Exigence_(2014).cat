    <selectionEntry id="697e-4e74-ded5-03e7" name="Supreme Aptimus Zaal &amp; Kovaas" publicationId="d740d6ea--pubN65554" page="46" hidden="false" collective="false" import="true" type="unit">
      <constraints>
        <constraint field="selections" scope="force" value="1" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="maxInForce" type="max"/>
        <constraint field="selections" scope="roster" value="1" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="maxInRoster" type="max"/>
      </constraints>
      <rules>
        <rule id="ce5b-2b32-7340-c5d2" name="Skorne Warlock &amp; Solo" hidden="false"/>
        <rule id="16b6-f957-c9d6-03d4" name="Feat: Rage of Ancients" hidden="false">
          <description>Zaal gains a number of acestral rage tokens equal to the number of friendly Faction warrior models that have been destroyed and not returned to play since the start of the game. While in Zaal&apos;s control area, friendly Faction models can spend ancestral rage tokens on Zaal to boost melee attack or melee damage rolls. At the end of the turn, remove unspent acestral rage tokens from Zaal.</description>
        </rule>
        <rule id="468c-f0d6-2960-cea0" name="Direct Spirits" hidden="false">
          <description>When a friendly living Faction warrior model is destroyed in this model&apos;s control area and generates a soul, you choose which eligiible model gains the sould, regardless of the proximity of other models. Enemy models never gain soul tokens for friendly living Faction warrior models destroyed in this model&apos;s control area.</description>
        </rule>
        <rule id="4a9d-3aec-5eaa-93e2" name="Union [Ancestral Guardians]" hidden="false">
          <description>This model can transfer damage to friendly Ancestral Guardians.</description>
        </rule>
        <rule id="78b5-102e-13a6-c0ca" name="Soul Converter" hidden="false">
          <description>Once per turn during its activation, this model can spend 1 fury point to give each Ancestral Guardian currently in its control area one soul token.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="cde4-7324-dcce-6acc" hidden="false" targetId="5e6058fb-90ea-a457-dbc7-66469fd1147a" type="rule" name="Gunfighter"/>
        <infoLink id="20dd-63f3-1553-202a" hidden="false" targetId="4b5c-253b-39a3-2868" type="rule" name="Ghost Sight"/>
      </infoLinks>
      <categoryLinks>
        <categoryLink id="697e-4e74-ded5-03e7-5761726c6f636b23232344415441232323" hidden="false" targetId="5761726c6f636b23232344415441232323" primary="true" name="Warlock"/>
      </categoryLinks>
