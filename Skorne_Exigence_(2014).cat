        <rule id="7dc2-e4a0-f89c-8844" name="Guidance (* Action)" hidden="false">
          <description>RNG 5. Target friendly Faction model. If the model is in range, it gains Eyeless Sight and its weapons gain Magical Weapon for one turn.</description>
        </rule>
        <rule id="3bb5-8908-01e6-7bd8" name="Spirit Guide" hidden="false">
          <description>During its activation, you can remove soul tokens from this model and place them on friendly Faction models in this model&apos;s command range that have the Soul Guardian ability. A model cannot have more than three soul tokens as a result of Spirit Guide.</description>
        </rule>
      </rules>
