                <characteristic name="SPD" typeId="5.3504423232344415e+25">6</characteristic>
                <characteristic name="STR" typeId="5.354522323234442e+25">0</characteristic>
                <characteristic name="MAT" typeId="4d415423232344415441232323">8</characteristic>
