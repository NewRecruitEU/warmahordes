      <rules>
        <rule id="a78c-a4f0-9a9b-02f1" name="Feat: Hand of the Ancients" hidden="false">
          <description>All models are in Xerxis&apos; control area. Friendly Faction models/units gain an additional die on attack and damage rolls. Discard one die form each roll. Hand of the Ancients lasts for one turn.</description>
        </rule>
        <rule id="4a4c-a21e-2f34-522e" name="Skorne Epic Cavalry Battle Engine Warlock" hidden="false"/>
        <rule id="911b-b1be-0139-edf5" name="Warbeast Bond" hidden="false">
          <description>One non-character warbeast in Xerxis&apos; battlegroup can begin the game bonded to him. Once per turn during his activation, Xerxis can cast the bonded warbeast&apos;s animus as a spell without spending fury.</description>
        </rule>
      </rules>
