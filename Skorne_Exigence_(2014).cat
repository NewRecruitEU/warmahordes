        <rule id="2abea527-80c2-7d4f-26d1-5f205652a169" name="Feat: Monster Mayhem" publicationId="d740d6ea--pubN68778" page="72" hidden="false">
          <description>Warbeasts in Arkadius&apos; battlegroup can immediately frenzy. A model can frenzy even if it has already activated this turn and does not affect whether it can activate later this turn.</description>
        </rule>
        <rule id="70e6-44e2-63a5-2bf9" name="Minion Warlock" hidden="false"/>
      </rules>
