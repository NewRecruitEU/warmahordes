          <description>This model gains a +1 cumulative bonus to melee attack and damage rolls for each Aradus wabeast or other model in this unit engaging the model it is attacking.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="1f43-d890-06a2-5264" hidden="false" targetId="137b368a-ff78-db3d-2fea-5dec4fc6d250" type="rule" name="Advance Deployment"/>
