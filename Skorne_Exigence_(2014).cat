        <constraint field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="maxSelections" type="max"/>
      </constraints>
      <profiles>
        <profile id="70ed-5fd0-1c73-234d" name="Bone Shaker" publicationId="d740d6ea--pubN68778" page="54" hidden="false" typeId="5370656c6c23232344415441232323" typeName="Spell">
          <characteristics>
