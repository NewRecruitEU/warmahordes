        <rule id="faf9-93d6-19ad-956b" name="Skorne Battle Engine" hidden="false"/>
        <rule id="6636-bdea-e66b-0e3d" name="Cantankerous" hidden="false">
          <description>When this model is damaged by an enemy attack it gains one rage token. This model can have up to three rage tokens at a time. For each rage token on this model when it declares a melee atack, it gains +1 to the damage roll. During its activation, this model can spend rage tokens to boost Club Tail melee attack or Club Tail damage rolls at one token per boost.</description>
        </rule>
      </rules>
