        <rule id="3fa4-a358-131f-74fc" name="Feat: Void Wind" hidden="false">
          <description>While in Mordikaar&apos;s control area, friendly Faction models gain +3 DEF and Poltergeist. Void Wind lasts for one round.</description>
        </rule>
        <rule id="6e76-c32f-0292-0e3a" name="Cull Soul" hidden="false">
          <description>This model gains one soul token for each living enemy model destroyed within 2&quot; of it. After this model leaches during your next Control Phase, replace each soul token on it with 1 fury point.</description>
        </rule>
        <rule id="fd18-a230-2bff-9651" name="Poltergeist" publicationId="d740d6ea--pubN65554" page="36" hidden="false"/>
