    <selectionEntry id="2470-eee5-1ffe-d502" name="Archdomina Makeda" publicationId="d740d6ea--pubN65554" page="32" hidden="false" collective="false" import="true" type="upgrade">
      <rules>
        <rule id="6bed-53a6-b7f9-d6b7" name="Feat: Walking Death" hidden="false">
          <description>For one round, friendly living Faction trooper models destroyed while in Makeda&apos;s control area return to play during your next Maintenance Phase with one unmarked damage box. Place returned models in Makeda&apos;s control area in formation and within 3&quot; of another model in their units. Returned models forfeit their normal movment the turn they are placed.</description>
        </rule>
        <rule id="8dce-5864-9675-bda8" name="Blood-Quenched" hidden="false">
          <description>This model gains a cumulative +1 STR and ARM for each living enemy model it destroys with a melee attack during its activation. This bonus lasts for one round.</description>
        </rule>
        <rule id="fb7a-7bc5-9ffa-a4c3" name="Inspiration [Skorne Models]" hidden="false">
          <description>Friendly Skorne models/units in this model&apos;s command range never flee and immediately rally.</description>
        </rule>
      </rules>
      <infoLinks>
