              <rules>
                <rule id="f974-6cf5-225e-c941" name="Granted: Side Step" hidden="false">
                  <description>While this model is in play, models in this unit gain Side Step. (When a model with Side Step hits with an initial attack or a special attack, after the attack is resolved it can advance 2&quot;. It cannot be targeted by free strikes during this movement.)</description>
                </rule>
                <rule id="edd9-717e-b170-d92d" name="Perfect Strike" hidden="false">
                  <description>Once per game during this unit&apos;s activation, this model can use Perfect Strike. During this activation, when making melee attacks, models in this unit can deal 1 damage point instead of making a damage roll.</description>
                </rule>
                <rule id="1ea9-453d-13f6-f008" name="Tactics: Ranked Attacks" hidden="false">
                  <description>Models in this unit gain Ranged attacks. (Friendly Faction models can ignore models with ranked attacks when determing LOS.)</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="e6b0-09f5-42c2-e6d6" hidden="false" targetId="0185cef5-a3c9-603c-100d-c470bee8d29f" type="rule" name="Officer"/>
