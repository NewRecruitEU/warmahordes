          <description>This attachment can be added to a Convergence unit.</description>
        </rule>
        <rule id="5975-dc52-2664-1860" name="Attachment Deployment" hidden="false">
          <description>If this model is attached to a unit with Advance Deployment, it gains Advance Deployment. If it is attached to a unit with Ambush, it gains Ambush.</description>
        </rule>
        <rule id="3175-8832-99e4-20fe" name="Realignment" hidden="false">
          <description>Once per game during its unit&apos;s activation, this model can use Realignment. Models in this unit can reroll failed attack rolls and skill checks this turn. Each roll can be rerolled only once as a result of Realignment.</description>
        </rule>
        <rule id="51f4-e3b0-8602-6671" name="Repair [9] (* Action)" hidden="false">
          <description>This model can attempt repairs on any damaged friendly Faction warjack. To attempt repairs, this model must be B2B with the damaged warjack and make a skill check. If successful, remove d6 damage points from the warjack&apos;s damage grid.</description>
        </rule>
      </rules>
