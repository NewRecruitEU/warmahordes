                <constraint field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="maxSelections" type="max"/>
              </constraints>
              <profiles>
                <profile id="eae2-32b5-7aaf-d61b" name="Aperture Pulse" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
                  <characteristics>
                    <characteristic name="RNG" typeId="524e4723232344415441232323">SP 10</characteristic>
                    <characteristic name="ROF" typeId="524f4623232344415441232323">1</characteristic>
                    <characteristic name="AOE" typeId="414f4523232344415441232323">-</characteristic>
                    <characteristic name="POW" typeId="504f5723232344415441232323">10</characteristic>
                    <characteristic name="P+S" typeId="502b5323232344415441232323"/>
                    <characteristic name="L/R/H" typeId="4c2f522f4823232344415441232323">-</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule id="5c44-ac3c-ceaa-c4be" name="Auto Fire [2]" publicationId="4a5f-40eb-pubN75673" page="92" hidden="false">
                  <description>Make 2 ranged attacks targeting a primary target and any number of secondary targets within 2&quot; of the first target. Ignore intervening models when declaring secondary targets. A secondary target cannot be targeted by more attacks than the primary target. Auto Fire counts as one attack for ROF.</description>
                </rule>
                <rule id="1c41-ab9c-d419-939c" name="Firing Formulae" hidden="false">
                  <description>When this model makes a ranged attack with this weapon during its activation, determine the position of the Permutation Servitors this model put into play. For each completely within its left firing arc, this model gains an additional die on its attack rolls. For each completely within its right firing arc, this model gains an additional die on its damage rolls. For each completely within its back arc, this model makes an additional Auto Fire attack.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
          </costs>
        </selectionEntry>
