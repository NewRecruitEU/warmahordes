                <characteristic name="P+S" typeId="502b5323232344415441232323">14</characteristic>
                <characteristic name="L/R/H" typeId="4c2f522f4823232344415441232323">R</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule id="b793-3820-cf7c-20f9" name="Assimilation" hidden="false">
