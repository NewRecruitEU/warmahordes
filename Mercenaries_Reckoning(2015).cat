        <profile id="c559-9d0d-ebc2-d6e6" name="2xWraithlock Pistol" page="0" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
          <characteristics>
            <characteristic name="RNG" typeId="524e4723232344415441232323">10</characteristic>
            <characteristic name="ROF" typeId="524f4623232344415441232323">1</characteristic>
            <characteristic name="AOE" typeId="414f4523232344415441232323">-</characteristic>
            <characteristic name="POW" typeId="504f5723232344415441232323">12</characteristic>
            <characteristic name="P+S" typeId="502b5323232344415441232323">-</characteristic>
            <characteristic name="L/R/H" typeId="4c2f522f4823232344415441232323">-</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="916f-72c5-58a1-b7ab" name="Model: Gunfighter" page="0" hidden="false"/>
        <rule id="e83c-ce88-0014-3363" name="Model: Incorporeal" page="0" hidden="false"/>
        <rule id="f6de-4e0c-7b10-148a" name="Model: Undead" page="0" hidden="false"/>
        <rule id="973a-f2d7-0ec3-aaa5" name="Model: Body Count" page="0" hidden="false">
          <description>This model gains one soul token each time it destroys a living enemy model. It can have up to three soul tokens at a time. During its activation, this model can spend soul tokens to bost attack or damage rolls at one token per boost.</description>
        </rule>
        <rule id="af18-c63e-ea17-8438" name="Wraithlock Pistols: Magical Weapons" page="0" hidden="false"/>
        <rule id="4ad8-fe05-2bc7-d529" name="Wraithlock Pistols: Chain Attack: Death Chill" page="0" hidden="false">
          <description>If this model hits the same model with both its initial attacks with this weapon, after resolving the attacks it can immediately make one additional ranged attack against that model ignoring ROF. If the additional attack hits, it does not inflict damage but the model hit must forfeit either its movement or action on its next activation.</description>
        </rule>
      </rules>
      <categoryLinks>
        <categoryLink id="5aab-ed83-aae0-955d-536f6c6f23232344415441232323" hidden="false" targetId="536f6c6f23232344415441232323" primary="true" name="Solo"/>
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="points" value="3"/>
      </costs>
    </selectionEntry>
