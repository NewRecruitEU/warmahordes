      <rules>
        <rule id="cbae-b62d-5124-f3fb" name="Granted: Fearless" hidden="false">
          <description>While this model is in play, models in its unit gain Fearless.</description>
        </rule>
        <rule id="9095-7731-4d8a-a43b" name="Granted: Tough" hidden="false">
