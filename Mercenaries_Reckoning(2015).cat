        <constraint field="selections" scope="roster" value="1" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="maxInRoster" type="max"/>
      </constraints>
      <rules>
        <rule id="75cdb7c5-a01d-0619-be1e-b53a74bc1678" name="Feat: Typhoon" hidden="false">
          <description>Advancing enemy models that end their movement in Montador&apos;s control area are knocked down. While in Montador&apos;s control area, enemy models suffer -3 on attack rolls. Typhoon lasts for one round.</description>
        </rule>
        <rule id="3807f9b0-df34-a2fb-31bf-9d1d40029fb8" name="Blood-Quenched" hidden="false">
          <description>This model gains a cumulative +1 STR and ARM for each living enemy model it destroys with a melee attack during its activation. This bonus lasts for one round.</description>
        </rule>
      </rules>
