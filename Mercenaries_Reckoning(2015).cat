      </characteristics>
    </profile>
    <profile id="597520f6-e1b9-156a-ae67-4c7adda910ce" name="Scattergun" publicationId="5382cf4f--pubN65553" page="38" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics>
        <characteristic name="RNG" typeId="524e4723232344415441232323">SP 8</characteristic>
        <characteristic name="ROF" typeId="524f4623232344415441232323">1</characteristic>
        <characteristic name="AOE" typeId="414f4523232344415441232323"/>
        <characteristic name="POW" typeId="504f5723232344415441232323">12</characteristic>
