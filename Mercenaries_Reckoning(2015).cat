        <rule id="4597-fc5e-9d0a-ec1d" name="Ranking Officer" hidden="false">
          <description>This model is a Ranking Officer.  While this model is in play, models in its unit are Mercenary Cephalyx models instead of Mercenary models.</description>
        </rule>
        <rule id="befc-c061-9779-22af" name="Granted: Advance Deployment" hidden="false">
          <modifiers>
            <modifier type="set" field="hidden" value="true"/>
          </modifiers>
          <description>Puppet Masters Special Rule: Units that include Cephalyx Dominator UAs gain Advance Deployment .</description>
        </rule>
