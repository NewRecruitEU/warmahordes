      <rules>
        <rule id="91eb5909-c88c-eee2-0cfe-e3ca64438254" name="Feat: Hit and Run" publicationId="5382cf4f--pubN65553" page="38" hidden="false">
          <description>Models in Magnus&apos; battlegroup currently in his control area can make a full advance or run after all friendly models have completed their activations this turn. Warjacks do not have to spend focus to run during this movement. During this movement models cannot be targeted by free strikes.</description>
        </rule>
      </rules>
      <infoLinks>
