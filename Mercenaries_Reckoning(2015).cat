        <profile id="c730-ac15-4793-8b22" name="Leader &amp; Grunts" hidden="false" typeId="54726f6f70657223232344415441232323" typeName="Trooper">
          <characteristics>
            <characteristic name="SPD" typeId="5.3504423232344415e+25">6</characteristic>
            <characteristic name="STR" typeId="5.354522323234442e+25">6</characteristic>
            <characteristic name="MAT" typeId="4d415423232344415441232323">6</characteristic>
            <characteristic name="RAT" typeId="5.2415423232344416e+25">4</characteristic>
            <characteristic name="DEF" typeId="4.445462323234441e+25">14</characteristic>
            <characteristic name="ARM" typeId="41524d23232344415441232323">13</characteristic>
