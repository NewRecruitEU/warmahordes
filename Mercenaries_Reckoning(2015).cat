    <profile id="809947fe-567b-ecd5-6116-df079d266ca8" name="Military Rifles" publicationId="5382cf4f--pubN65553" page="50" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics>
        <characteristic name="RNG" typeId="524e4723232344415441232323">10</characteristic>
