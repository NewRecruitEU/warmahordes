      <rules>
        <rule id="5975f5a4-6119-4d64-0c96-ac3da4ac7402" name="Feat: Godspeed" hidden="false">
          <description>Friendly models currently in Shae&apos;s control area immediately advance up to 3&quot;. During this movement, affected models gain Pathfinder and cannot be targeted by free strikes.</description>
        </rule>
        <rule id="e28b1ded-a8b5-b571-9f0e-9dcc2c3f1b1b" name="Mercenary" hidden="false">
          <description>Shae can be included only in armies that list him as a possible member.</description>
        </rule>
