      </constraints>
      <rules>
        <rule id="c1c2-fe44-0884-afe8" name="Feat: Iron Fist" hidden="false">
          <description>Friendly Faction models that charge or slam power attack an enemy model while that model is in Strakhov&apos;s control area gain +4&quot; movement and Pathfinder. Warjacks in Strakhov&apos;s battlegroup can charge and slam power attack an enemy model while the enemy model is in Strakhov&apos;s control area without spending focus. Iron Fist lasts for one round.</description>
        </rule>
        <rule id="4b02-df72-f609-cd7d" name="Elite Cadre [Assault Kommandos]" hidden="false">
          <description>Friendly Assault Kommando models gain Pathfinder.</description>
        </rule>
      </rules>
      <infoLinks>
