                    <characteristic name="UP" typeId="5.5502323234441546e+23">YES</characteristic>
                    <characteristic name="OFF" typeId="4f464623232344415441232323">NO</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule id="b5fe-cffe-16a9-5923" name="Avatar of Slaughter" hidden="false">
                  <description>Target this model or Scrapjack. The affected model gains +2 to melee attack rolls. When it destroys an enemy warrior model with a melee attack during its activation, after the attack is resolved the affected model can advance up to 1&quot; and make an additional melee attack.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
