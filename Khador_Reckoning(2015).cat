    <selectionEntry id="8a0f-1c1f-6e67-cda1" name="Berserker" publicationId="2c35-dc21-pubN67109" page="70" hidden="false" collective="false" import="true" type="model">
      <rules>
        <rule id="d14c-c87f-dc5a-12d6" name="Aggressive" hidden="false">
          <description>This model can run or charge without spending focus or being forced.</description>
        </rule>
        <rule id="9e9b-2013-d3ff-89fc" name="Unstable" hidden="false">
          <description>At the end of any activation in which this model spent 1 or more focus points, roll a d6. If the roll is equal to or less than the number of focus points spent, this model explodes and models within 3&quot; of it suffer an unboostable POW 14 blast damage roll. Remove this model from play.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="6b73-d6ce-816c-3444" hidden="false" targetId="d747-7710-acba-a127" type="rule" name="Khador Heavy Warjack"/>
      </infoLinks>
      <categoryLinks>
        <categoryLink id="8a0f-1c1f-6e67-cda1-5761726a61636b23232344415441232323" hidden="false" targetId="5761726a61636b23232344415441232323" primary="true" name="Warjack"/>
      </categoryLinks>
      <selectionEntries>
        <selectionEntry id="b7eb-3b26-e6de-52f9" name="War Axe" hidden="false" collective="false" import="true" type="upgrade">
