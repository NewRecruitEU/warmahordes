          <rules>
            <rule id="1612-cd34-7fda-6edc" name="Companion [Old Witch]" hidden="false">
              <description>This model is included in any army that includes the Old Witch. If the Old Witch is destroyed or removed from play, remove this model from play. This model is part of the Old Witch&apos;s battlegroup.</description>
            </rule>
            <rule id="227a-63cd-1ecc-9d18" name="Warjack Bond [Old Witch]" hidden="false">
              <description>This model is bonded to the Old Witch. When the Old Witch is damaged by an enemy attack, this model gains +2 SPD and +2 to attack and damage rolls for one round.</description>
            </rule>
          </rules>
          <infoLinks>
