          <description>Friendly Sea Dogs models/units in this model&apos;s command range never flee and immediately rally.</description>
        </rule>
        <rule id="d5be31ac-405e-7c24-7a69-80c15916888c" name="Object of Desire" publicationId="2c35-dc21-pubN65551" page="124" hidden="false">
