              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule id="f4f5-c131-bde7-7118" name="Chain Attack: Bloodbath" hidden="false">
              <description>If this model hits the same target with both its initial attacks with this weapon, after resolving the attacks it can immediately make one melee attack with this weapon against each model in its LOS that is in this weapon&apos;s melee range.</description>
            </rule>
            <rule id="2622-596e-3c2f-7279" name="Critical Amputation" hidden="false">
              <description>On a critical hit, warjack head and arm systems that suffer damage from this attack are crippled.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
          </costs>
        </selectionEntry>
