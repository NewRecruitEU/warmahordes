            <rule id="7d39-195c-4f2e-5b23" name="Tier 2 Benefit" hidden="true">
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditions>
                    <condition field="selections" scope="8884-8a50-f038-7dad" value="2" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="dfca-1d4d-6d0b-1dd5" type="atLeast"/>
                  </conditions>
                </modifier>
              </modifiers>
              <description>For each Greylord unit in the army, one warjack gains Advanced Move. (Before the start of the game but after both players have deployed, a model with Advance Move can make a full advance.)</description>
            </rule>
            <rule id="ffe1-7408-3b16-5d9e" name="Winter&apos;s Wind Tier" hidden="false">
              <description>Warjacks: Khador non-character warjacks

Units: Doom Reaver units, Greylord units, Winter Guard units

Solos: Doom Reaver solos, Greylord solos</description>
            </rule>
            <rule id="f1dd-90ad-0a1b-06bc" name="Tier 3 Benefit" hidden="true">
              <modifiers>
                <modifier type="set" field="hidden" value="false">
