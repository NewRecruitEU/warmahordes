        <profile id="ea4b-258e-617c-0496" name="Leader &amp; Grunts" hidden="false" typeId="54726f6f70657223232344415441232323" typeName="Trooper">
          <characteristics>
            <characteristic name="SPD" typeId="5.3504423232344415e+25">6</characteristic>
            <characteristic name="STR" typeId="5.354522323234442e+25">5</characteristic>
