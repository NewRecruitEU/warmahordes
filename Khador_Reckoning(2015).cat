        <constraint field="selections" scope="roster" value="1" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="maxInRoster" type="max"/>
      </constraints>
      <rules>
        <rule id="0a23-169b-f272-cd3c" name="Feat: Forced March" hidden="false">
          <description>Warjacks in Vladimir&apos;s battlegroup beginning their activations in his control area double their base SPD and can run or charge without spending focus. Forced March lasts for one turn.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="d79e-3222-1551-aa4b" hidden="false" targetId="ad6ef5a7-c76a-7a24-e837-f77a76cc406c" type="rule" name="Parry"/>
      </infoLinks>
