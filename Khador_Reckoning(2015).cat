      <rules>
        <rule id="2c31-0704-7894-2abc" name="Arcane Reckoning" page="0" hidden="false">
          <description>Target friendly Faction model / unit gain Whiplash. (When an enemy model misses a model with Whiplash with a magic attack, the attacking model becomes the target and is automatically hit by the attack. AOE magic attacks that miss are centered on the attacking model. the model with Whiplash is the point of origin for all these attacks.)</description>
        </rule>
      </rules>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
