        <rule id="4eb0-2f45-eaa6-e9e5" name="Elite Cadre [Iron Fang Uhlans]" hidden="false">
          <description>Friendly Iron Fang Uhlan units gain Practiced Maneuvers. (A model with Practiced Maneuver can ignore other models in its unit when determining LOS and can advance through other models in its unit if it has enough movement to move completely past them.)</description>
        </rule>
        <rule id="dc75-c7fd-9b96-69aa" name="Inspiration [Iron Fang Uhlans]" hidden="false">
          <description>Friendly Iron Fang Uhlan models/units in this model&apos;s command range never flee and immediately rally.</description>
        </rule>
      </rules>
