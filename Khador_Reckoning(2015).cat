    <selectionEntry id="559c-4258-fb44-a5f0" name="Forward Kommander Sorscha Kratikoff" publicationId="2c35-dc21-pubN67109" page="54" hidden="false" collective="false" import="true" type="model">
      <modifiers>
        <modifier type="set" field="maxInForce" value="0">
          <conditionGroups>
