    <selectionEntry id="6d4e-4374-4af1-7979" name="Behemoth" publicationId="2c35-dc21-pubN67109" page="80" hidden="false" collective="false" import="true" type="model">
      <modifiers>
        <modifier type="set" field="maxInForce" value="0">
          <conditionGroups>
