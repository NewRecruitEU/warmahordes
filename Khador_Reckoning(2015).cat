            <characteristic name="DEF" typeId="4.445462323234441e+25">12</characteristic>
            <characteristic name="ARM" typeId="41524d23232344415441232323">14</characteristic>
            <characteristic name="CMD" typeId="434d4423232344415441232323">6</characteristic>
            <characteristic name="Damage" typeId="44616d61676523232344415441232323">5</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="c3cb346e-9b04-08ba-0a07-fe1ae148efdd" name="Rockbottom&apos;s Coins: 5" hidden="false"/>
        <rule id="8c900c03-6aca-a81c-76a0-569ee10f8c06" name="Bought Loyalty" hidden="false">
          <description>When a friendly Faction model/unit fails a command check in this modelæs command range, you can mark one of this model&apos;s five coin boxes to cause the model/unit to pass the failed check.</description>
        </rule>
        <rule id="bf149e39-b99a-6a5f-98e8-4734a90c4a1c" name="Coin" hidden="false">
          <description>This model gains +1 CMD for each of its unmarked coin boxes.</description>
        </rule>
        <rule id="de0bb81b-a5b5-0349-df28-8675ded13a50" name="Paymaster" hidden="false">
          <description>During this model&apos;s activation, you can mark one or more coin boxes on its card. For each coin box you mark, you can use Paymaster once. When you do, choose one of the following incentives. Incentives are RNG CMD, and can target only friendly Sea Dog units. A Sea Dog unit can be affected by an incentive only once per turn. When all five of its coin boxes have b een marked, this model loses Paymaster for the rest of the game.

- Money Shot - Affected models gain +2 to ranged attack and damage rolls for one turn.

- Payday - Affected models&apos; melee attack rolls are boosted. When an affected model destroys an enemy model with a normal melee attack, immediately after the attack is resolved the affected model can advance up to 1&quot;. Payday lasts for one turn.

- Walk It Off - Affecte models gain Tough for one round.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="13f1b75f-1e8f-afa3-1f41-cafce36f2a0b" hidden="false" targetId="400b902b-958e-5f17-8920-0df3fad42c49" type="rule" name="Mercenary: Cryx"/>
