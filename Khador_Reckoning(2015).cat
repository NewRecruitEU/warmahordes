        <profile id="6bd6ffb6-18df-0405-f410-c7c8a97829f3" name="Lord Rockbottom, Expedition Financier" hidden="false" typeId="54726f6f70657223232344415441232323" typeName="Trooper">
          <characteristics>
            <characteristic name="SPD" typeId="5.3504423232344415e+25">4</characteristic>
            <characteristic name="STR" typeId="5.354522323234442e+25">6</characteristic>
            <characteristic name="MAT" typeId="4d415423232344415441232323">6</characteristic>
