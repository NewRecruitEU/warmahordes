            <characteristic name="RAT" typeId="5.2415423232344416e+25">6</characteristic>
            <characteristic name="DEF" typeId="4.445462323234441e+25">13</characteristic>
            <characteristic name="ARM" typeId="41524d23232344415441232323">15</characteristic>
