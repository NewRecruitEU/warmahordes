                <characteristic name="L/R/H" typeId="4c2f522f4823232344415441232323">S</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule id="3627-7929-79eb-6994" name="Minimum Range [6]" hidden="false">
              <description>Attacks made with this weapon cannot target any model within 6&quot; of it.</description>
            </rule>
            <rule id="3c4b-9773-98fc-c12a" name="Attack Type" hidden="false">
              <description>Each time this model makes a normal Siege Mortar attack, choose one of the following abilities:

Crater – The AOE is rough terrain and remains in play for one round.

Flare – Models hit by this attack suffer –2 DEF for one round.

Incendiary – This attack causes fire damage, and models hit suffer the Fire continuous effect.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="6a42-0728-6511-98b3" hidden="false" targetId="1190f14c-e530-15eb-7a53-cb571bafe626" type="rule" name="Arcing Fire"/>
            <infoLink id="2fc2-cf96-6cd6-3612" hidden="false" targetId="4207-c3a1-6de8-3053" type="rule" name="Inaccurate"/>
          </infoLinks>
