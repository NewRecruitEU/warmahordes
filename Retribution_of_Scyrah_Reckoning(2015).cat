        </profile>
        <profile id="869a30d7-b10f-7448-62cb-30420e4b64f8" name="Chain Blast" page="0" hidden="false" typeId="5370656c6c23232344415441232323" typeName="Spell">
          <characteristics>
            <characteristic name="COST" typeId="434f535423232344415441232323">3</characteristic>
            <characteristic name="RNG" typeId="524e4723232344415441232323">10</characteristic>
            <characteristic name="AOE" typeId="414f4523232344415441232323">3</characteristic>
            <characteristic name="POW" typeId="504f5723232344415441232323">12</characteristic>
            <characteristic name="UP" typeId="5.5502323234441546e+23">NO</characteristic>
