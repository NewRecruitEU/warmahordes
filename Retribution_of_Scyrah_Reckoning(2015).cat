      <profiles>
        <profile id="17fc-fe51-5b36-d741" name="Explosivo" hidden="false" typeId="5370656c6c23232344415441232323" typeName="Spell">
          <characteristics>
            <characteristic name="COST" typeId="434f535423232344415441232323">1</characteristic>
