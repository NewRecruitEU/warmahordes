      <rules>
        <rule id="be1adfdc-9bd5-2680-4505-5c08dfb5eca5" name="Righteous Fury" page="0" hidden="false">
          <description>When one or more friendly Faction warrior models are destroyed by an enemy attack while in this model&apos;s command range, this model gains +2 STR and ARM for one round.</description>
        </rule>
        <rule id="6c0d6f92-2cdb-f666-d5ce-b8f0a9538ef8" name="Rapid Strike" page="0" hidden="false">
          <description>This model can make one additional melee attack each combat action.</description>
        </rule>
      </rules>
