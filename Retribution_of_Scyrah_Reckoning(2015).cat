      <rules>
        <rule id="032f-3a96-8f5c-8c49" name="Affliction" hidden="false">
          <description>When a damage roll resulting from a direct hit fails to exceed the ARM of the target enemy model/unit, the affected model hit suffers 1 damage point.</description>
        </rule>
