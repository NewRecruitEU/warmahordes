            <characteristic name="OFF" typeId="4f464623232344415441232323">YES</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="8a2e-66f0-287e-046b" name="Pursuit" hidden="false">
          <description>If target enemy model/unit advances during its normal movement, immediately after ending this movement one model in this model’s battlegroup that is in its control area can make a full advance.</description>
        </rule>
      </rules>
