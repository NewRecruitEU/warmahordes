              <characteristics>
                <characteristic name="RNG" typeId="524e4723232344415441232323"/>
                <characteristic name="ROF" typeId="524f4623232344415441232323"/>
                <characteristic name="AOE" typeId="414f4523232344415441232323"/>
                <characteristic name="POW" typeId="504f5723232344415441232323">4</characteristic>
                <characteristic name="P+S" typeId="502b5323232344415441232323">11</characteristic>
                <characteristic name="L/R/H" typeId="4c2f522f4823232344415441232323"/>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule id="d0eb-1f8f-5d1e-1d91" name="Power Gauntlet - Combo Smite (* Attack)" page="0" hidden="false">
              <description>Make a melee attack. On a hit, instead of making a normal damage roll, the target model is slammed d6&quot; directly away from this model and suffers a damage roll with POW equal to this model&apos;s STR plus the POW of this weapon. The POW of collateral damage is equal to this model&apos;s STR.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="6e35-0aa7-c8b9-1707" hidden="false" targetId="e0f48764-b12b-acca-bb70-726be718b29d" type="rule" name="Magical Weapon"/>
