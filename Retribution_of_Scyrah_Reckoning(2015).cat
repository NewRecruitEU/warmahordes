      <profiles>
        <profile id="9a04-83ff-ef18-e8cd" name="Admonition" hidden="false" typeId="5370656c6c23232344415441232323" typeName="Spell">
          <characteristics>
            <characteristic name="COST" typeId="434f535423232344415441232323">2</characteristic>
            <characteristic name="RNG" typeId="524e4723232344415441232323">6</characteristic>
            <characteristic name="AOE" typeId="414f4523232344415441232323">-</characteristic>
