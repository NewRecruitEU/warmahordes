          <rules>
            <rule id="70ee-3ab3-74f6-d81c" name="Blood Reaper" hidden="false">
              <description>When this model makes its first melee attack during its activation, it makes one melee attack with this weapon against each model in its LOS and this weapon&apos;s melee range.</description>
            </rule>
            <rule id="c39d-8318-6acc-1374" name="Grinding Wheel" hidden="false">
              <description>This weapon gains an additional die on attack rolls against small-based models.</description>
            </rule>
            <rule id="40ee-26b6-61c0-4164" name="Trash" hidden="false">
              <description>Gain an additional damge die against knocked down targets.</description>
            </rule>
