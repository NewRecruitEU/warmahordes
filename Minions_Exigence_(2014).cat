                    <characteristic name="OFF" typeId="4f464623232344415441232323">NO</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule id="c9b0-03fb-2233-bfa2" name="Bear Hands" hidden="false">
                  <description>When this model hits an enemy model with a normal melee attack, it can choose to knock down the enemy model or push it 3&quot; directly away. Bear Hands lasts for one turn.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
