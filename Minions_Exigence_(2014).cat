          <rules>
            <rule id="a82e-e4e5-7945-5bd0" name="Auto Fire [2d3]" publicationId="7de19a40--pubN71431" page="92" hidden="false">
              <description>Make 2d3 ranged attacks targeting a primary target and any number of secondary targets within 2&quot; of the first target. Ignore intervening models when declaring secondary targets. A secondary target cannot be targeted by more attacks than the primary target. Auto Fire counts as one attack for ROF.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
          </costs>
        </selectionEntry>
