          <characteristics>
            <characteristic name="COST" typeId="434f535423232344415441232323">2</characteristic>
            <characteristic name="RNG" typeId="524e4723232344415441232323">CTRL</characteristic>
            <characteristic name="AOE" typeId="414f4523232344415441232323">-</characteristic>
            <characteristic name="POW" typeId="504f5723232344415441232323">*</characteristic>
            <characteristic name="UP" typeId="5.5502323234441546e+23">NO</characteristic>
            <characteristic name="OFF" typeId="4f464623232344415441232323">YES</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="470e-2398-a860-3e8d" name="Primal Shock" hidden="false">
          <description>Choose a friendly Faction warbeast in this model&apos;s control area. Target an enemy model within 8&quot; of the chosen warbeast and make a magice attack against it. The chosen warbeast is the attack&apos;s point of origin. If the enemy model is hit, it suffers a damage roll with a POW equal to the warbeast&apos;s base STR.</description>
        </rule>
      </rules>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
    </selectionEntry>
