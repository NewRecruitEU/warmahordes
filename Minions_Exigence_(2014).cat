      <rules>
        <rule id="d7aca785-331e-a541-6139-f86dadab9322" name="Feat: Hog Heaven" publicationId="7de19a40--pubN65554" page="74" hidden="false">
          <description>While in Carver&apos;s control area, friendly Farrow models gain Overtake and an additional die on melee damage rolls. Hog Heaven lasts for one turn. (When a model with Overtake destroys one or more enemy warrior models with a normal melee attack, after the attack is resolved the model with Overtake can immediately advance up to 1&quot;.)</description>
        </rule>
        <rule id="faf3f952-aabf-e879-440b-4d37c7bf9862" name="Elite Cadre (Farrow Brigands)" publicationId="7de19a40--pubN65554" page="74" hidden="false">
          <description>Friendly Farrow Brigand models gain Combined Ranged Attack.</description>
        </rule>
        <rule id="30597181-a0a9-8142-0485-10fbeeb9b597" name="Minion Farrow Warlock" hidden="false"/>
