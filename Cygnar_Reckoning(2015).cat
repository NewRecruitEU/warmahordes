        <rule id="0a6b-c43e-e61e-62da" name="Soul Gate" page="0" hidden="false">
          <description>Remove a friendly trooper model in this model&apos;s control are from play and replace it with target warjack in this model&apos;s battlegroup that is in its control area. LOS to that target is not required. The warjack cannot activate this turn after being placed by Soul Gate.</description>
        </rule>
      </rules>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
    </selectionEntry>
