Solos: Journeyman Warcaster, Stormblade solos</description>
            </rule>
            <rule id="da1a-c513-cc7d-3c6d" name="Tier 1 Benefit" hidden="true">
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditionGroups>
                    <conditionGroup type="and">
                      <conditions>
                        <condition field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="822b-a0b2-7445-1846" type="atLeast"/>
