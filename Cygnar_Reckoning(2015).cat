      <rules>
        <rule id="818a36fb-8da2-94f3-2ffd-1ae19dc99e85" name="Feat: Bombs Away" hidden="false">
          <description>While in Madhammer&apos;s control area, friendly Faction models gain an additional die on blast damage rolls and AOE ranged attack rolls this turn.</description>
        </rule>
        <rule id="1fb7116c-63bc-2389-175d-d93769a4ca81" name="Blast Armor" hidden="false">
          <description>When this model would suffer blast damage, it gains 1 focus point instead of suffering the damage. It cannot gain focus points beyond its FOCUS as a result of Blast Armor.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="2fdedbcd-1894-3c55-ebe2-2ef48ba54444" hidden="false" targetId="d39899c1-1611-2c72-016f-fe90fec55935" type="rule" name="Mercenary: Cygnar"/>
