      <rules>
        <rule id="2ac2-aeed-5c4a-ac86" name="Ghost Walk" hidden="false">
          <description>Target friendly model/unit gains Ghostly for one turn. (A model with Ghostly can advance through terrain and obstacles without penalty and can advance through obstructions if it has enough movement to move completely past them. An affected model cannot be targeted by free strikes.)</description>
        </rule>
      </rules>
      <costs>
