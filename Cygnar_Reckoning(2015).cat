          <profiles>
            <profile id="c13c-a8bc-ad88-8b2d" name="Buster" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
              <characteristics>
                <characteristic name="RNG" typeId="524e4723232344415441232323">12</characteristic>
                <characteristic name="ROF" typeId="524f4623232344415441232323">1</characteristic>
                <characteristic name="AOE" typeId="414f4523232344415441232323">4</characteristic>
