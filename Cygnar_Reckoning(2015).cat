      <rules>
        <rule id="1d36-3511-46c5-249e" name="Feat: Maelstrom" hidden="false">
          <description>Caine makes a normal Spellstorm Pistol attack against every enemy model currently in his control area, ignoring intervening models.  Caine cannot use Maelstrom while he is in melee. When resolving Maelstrom, Caine has no back arc and his front arc extends to 360°.</description>
        </rule>
        <rule id="124a-e9c6-351b-a253" name="Sons of the Tempest Tier 3 Benefit" hidden="true">
          <modifiers>
            <modifier type="set" field="hidden" value="false">
