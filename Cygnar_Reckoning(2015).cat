      <rules>
        <rule id="f798-b461-3375-8296" name="Gate Crasher" hidden="false">
          <description>Place this model anywhere completely within 8&quot; of its current location. After casting Gate Crasher, it cannot advance this activation. For the rest of this activation, this model&apos;s ranged attacks must target models in its melee range. Gate Crasher can be cast only once per activation.</description>
        </rule>
      </rules>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
