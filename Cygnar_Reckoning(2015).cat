                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
              <description>Up to one heavy warjack gains Advance Move for each Field Mechanik unit in the army. (Before the start of the game but after both players have deployed, a model with Advance Move can make a full advance.)</description>
            </rule>
            <rule id="1048-40c8-f438-3182" name="Tier 2 Benefit" hidden="false">
