          </constraints>
          <rules>
            <rule id="81e7-9093-162c-b579" name="The Huntsman" hidden="false">
              <description>Warjacks: Cygnar non-character light warjacks

Units: Arcane Tempest Units, Rangers

Solos: Arcane Tempest Solos</description>
            </rule>
            <rule id="6bfe-3055-4abd-a9a0" name="Tier 1 Benefit" hidden="true">
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditions>
                    <condition field="selections" scope="b33d-645e-80fc-fd01" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="e2a4-19df-7168-517b" type="atLeast"/>
                  </conditions>
                </modifier>
              </modifiers>
              <description>You can redeploy one unit/ model after both players have deployed but before the first player&apos;s first tum. The redeployed models must be placed on the table in a location they could have been deployed initially.</description>
            </rule>
            <rule id="c34a-46bc-4292-1754" name="Tier 3 Benefit" hidden="true">
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditions>
                    <condition field="selections" scope="b33d-645e-80fc-fd01" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="e2a4-19df-7168-517b" type="atLeast"/>
                  </conditions>
                </modifier>
              </modifiers>
              <description>Your deployment is extended 2· forward.</description>
            </rule>
            <rule id="ac6a-81fc-009c-eab7" name="Tier 4 Benefit" hidden="true">
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditions>
                    <condition field="selections" scope="b33d-645e-80fc-fd01" value="4" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="e2a4-19df-7168-517b" type="equalTo"/>
                  </conditions>
                </modifier>
              </modifiers>
              <description>Friendly models/ units can begin the game affected by Caine&apos;s upkeep spells.  These spells and their targets must be declared before either player sets up models. Caine does not pay focus to upkeep these spells during your first turn.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
          </costs>
        </selectionEntry>
