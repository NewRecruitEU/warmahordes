      </profiles>
      <rules>
        <rule id="5086-5ae1-5fb4-252c" name="Lightning Storm" hidden="false">
          <description>Models hit suffer a POW 10 electrical damage roll. The AOE remains in play for one round. Models entering or ending their activations in the AOE suffer a POW 10 electrical damage roll.</description>
