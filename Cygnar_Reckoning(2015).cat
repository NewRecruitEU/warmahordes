      <rules>
        <rule id="76de-30f6-7ab1-34aa" name="Sentry" hidden="false">
          <description>When an enemy model advances and ends its movement in the LOS of a target friendly Faction model, the affected model can immediately make one normal ranged attack, then Sentry expires.</description>
        </rule>
      </rules>
