          <rules>
            <rule id="498d-701b-95ee-4d57" name="Strafe [d6] (* Attack)" hidden="false">
              <description>Make d6 ranged attacks targeting a primary target and any number of secondary targets within 2&quot; of the first target. Ignore intervening models when declaring secondary targets. A secondary target cannot be targeted by more attacks than the primary target. Strafe counts as one attack for ROF.</description>
            </rule>
          </rules>
