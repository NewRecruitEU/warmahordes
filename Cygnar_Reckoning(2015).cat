          <rules>
            <rule id="1382-74ae-cd19-7c18" name="The Big Guns Tier" hidden="false">
              <description>Warjacks: Cygnar non-character warjacks

Units: Field Mechaniks, Rangers, Trencher units

Solos: Journeyman Warcaster, Trencher solos</description>
            </rule>
            <rule id="3cc0-1579-4da8-e4dd" name="Tier 3 Benefit" hidden="true">
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditions>
                    <condition field="selections" scope="904f-011e-fffc-b693" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="7deb-ec0f-4994-c961" type="atLeast"/>
                  </conditions>
                </modifier>
              </modifiers>
              <description>For each Trencher Commando or Trencher Infantry unit, place one 3&quot; AOE cloud effect anywhere completely within 20&quot; of the back edge of Siege&apos;s deployment zone after both players have finished deploying their armies but before the first player takes his first turn. These cloud effects leave play after the first round of the game.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
          </costs>
        </selectionEntry>
