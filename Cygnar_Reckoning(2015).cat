            <characteristic name="OFF" typeId="4f464623232344415441232323">NO</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="5677-0d48-3b4b-160e" name="Scything Touch" page="0" hidden="false">
          <description>Target friendly model/unit gains +2 to melee attack damage rolls. Affected models gain Critical Corrosion on their normal melee attacks.</description>
        </rule>
      </rules>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
